# Copy to demo/backend/.env and replace every placeholder.
ENVIRONMENT=development
SECRET_KEY=replace-with-at-least-32-random-characters
DEBUG=false
ALLOW_PUBLIC_REGISTRATION=false
REQUIRE_INVITE_CODE=true
SEED_LOCAL_ADMIN=false
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=

# Choose either MODEL_NAME=gpt-5.6-sol or MODEL_NAME=deepseek-v4-pro.
# Provider-specific keys are selected from the model; never commit real keys.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
BASE_URL=https://api.openai.com/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_NAME=gpt-5.6-sol
AGENT_MODEL_NAME=gpt-5.6-sol
REASONING_EFFORT=high

# Optional trusted OpenAI-compatible gateways, exact hostnames only. A request
# that overrides BASE_URL must provide its own API key unless it targets the
# matching official provider or this server-configured BASE_URL.
MMAGENT_ALLOWED_LLM_HOSTS=
ALLOW_LOCAL_LLM_URLS=false
MMAGENT_ALLOWED_ASSET_HOSTS=
MAX_ASSET_DOWNLOAD_BYTES=104857600

# Only list trusted browser origins; do not use '*'.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
